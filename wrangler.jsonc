{
  // Minimal, committed config so bindings and non-secret vars survive every
  // deploy instead of depending on dashboard settings that weren't
  // persisting across new versions -- once this file exists, it's the
  // source of truth for vars/bindings, dashboard-only entries not listed
  // here stop applying. No secrets here: database_id and the domain are
  // identifiers, not credentials. Discord secrets still live in the
  // dashboard (Settings > Variables and secrets), untouched by this file.
  "name": "cinderbox",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DISPOSABLE_DOMAIN": "vsvn.net",
    "ADAPTERS": "discord"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cinderbox",
      "database_id": "80611409-6ad6-4226-a988-238e3d2e01fa"
    }
  ]
}
