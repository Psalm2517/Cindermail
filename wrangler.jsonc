{
  // Minimal, committed config so the D1 binding survives every deploy
  // instead of depending on a dashboard setting that wasn't persisting
  // across new versions. No secrets here -- database_id is an identifier,
  // not a credential. Discord secrets and DISPOSABLE_DOMAIN/ADAPTERS still
  // live in the dashboard (Settings > Variables and secrets), unaffected
  // by this file.
  "name": "cinderbox",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cinderbox",
      "database_id": "80611409-6ad6-4226-a988-238e3d2e01fa"
    }
  ]
}
