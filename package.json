{
  "name": "cinderbox",
  "version": "1.0.0",
  "description": "Disposable email addresses on your own domain, delivered to Discord DMs. Cloudflare Worker + D1, with a pluggable adapter interface.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute cinderbox --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute cinderbox --local --file=schema.sql",
    "register-commands": "node --experimental-strip-types src/adapters/discord/register-commands.ts"
  },
  "keywords": [
    "cloudflare-workers",
    "email-routing",
    "disposable-email",
    "discord-bot",
    "d1"
  ],
  "dependencies": {
    "discord-interactions": "^4.4.0",
    "postal-mime": "^2.7.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.118.0"
  }
}
