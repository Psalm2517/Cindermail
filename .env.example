# Copy to .env and fill in. This is the self-hosted (Node/VPS/Docker) path
# only — if you're deploying to Cloudflare Workers instead, see
# wrangler.toml.example and use `wrangler secret put` for the Discord
# credentials; none of this file applies there.

# The domain addresses are generated on. Its MX records must point at this
# machine's own public IP (an A/AAAA record), not at Cloudflare — this is a
# genuinely different DNS setup than the Workers deployment path. See the
# README's "Self-host on your own server" section.
DISPOSABLE_DOMAIN=example.com

# Comma-separated enabled delivery adapters. Currently just "discord".
ADAPTERS=discord

# Port the SMTP server listens on for inbound mail. Standard mail delivery
# expects port 25. If running via Docker, leave this as the container's
# internal port and map the real port 25 to it instead (see Dockerfile /
# README) so the process never needs root to bind a privileged port.
SMTP_PORT=25
SMTP_HOST=0.0.0.0

# Port the HTTP server listens on for Discord's /interactions webhook.
# You're responsible for getting this reachable at a public HTTPS URL
# yourself (a reverse proxy such as Caddy or nginx with a real certificate,
# or a tunnel) — Discord requires HTTPS for the Interactions Endpoint URL,
# which this bare HTTP server does not provide on its own.
HTTP_PORT=8787

# Where the SQLite database file lives. Created automatically (schema
# applied on first run) if it doesn't exist yet.
SQLITE_PATH=./cinderbox.db

# From your Discord application's settings (discord.com/developers/applications).
DISCORD_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# Optional — see README "Configuration" for the full list and defaults.
# Uncomment and adjust only if you want different limits than the defaults.
# MAX_ACTIVE_ADDRESSES=5
# ADDRESS_TTL_SECONDS=604800
# RATE_LIMIT_NEW_WINDOW_SECONDS=30
# RATE_LIMIT_NEW_MAX=1
# RATE_LIMIT_LIST_WINDOW_SECONDS=60
# RATE_LIMIT_LIST_MAX=15
# RATE_LIMIT_EXTEND_WINDOW_SECONDS=60
# RATE_LIMIT_EXTEND_MAX=15
# RATE_LIMIT_TORCH_WINDOW_SECONDS=60
# RATE_LIMIT_TORCH_MAX=15
